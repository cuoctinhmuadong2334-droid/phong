{
  "name": "phong",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion video project",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render HelloWorld out/video.mp4",
    "build:jersey": "remotion render JerseyShowcase out/jersey.mp4",
    "build:chalpha": "remotion render ChAlphaPromo out/chalpha.mp4",
    "build:chalpha-stats": "remotion render ChAlphaStatsPromo out/chalpha-stats.mp4",
    "build:chalpha-kv": "remotion render ChAlphaKeyVisual out/chalpha-kv.mp4",
    "build:chalpha-story": "remotion render ChAlphaStory out/chalpha-story.mp4",
    "build:chalpha-voice": "remotion render ChAlphaVoice out/chalpha-voice.mp4",
    "upgrade": "remotion upgrade",
    "lint": "tsc",
    "build:denoise": "remotion render DenoiseLogo16x9 out/denoise-16x9.mp4",
    "build:error-text": "remotion render ErrorReturnGreen out/error-return-green.mp4 --codec=h264 --image-format=png --crf=10 --x264-preset=veryslow --pixel-format=yuv420p --color-space=bt709",
    "build:error-text-4k": "remotion render ErrorReturnGreen out/error-return-green-4k.mp4 --scale=2 --codec=h264 --image-format=png --crf=10 --x264-preset=veryslow --pixel-format=yuv420p --color-space=bt709",
    "build:error-text-alpha": "remotion render ErrorReturnAlpha out/alpha-seq --sequence --image-format=png && python3 tools/premult_encode.py out/alpha-seq out/error-return-alpha-premult.mov 60 && python3 tools/make_sfx.py && remotion ffmpeg -y -i out/error-return-alpha-premult.mov -i public/sfx/error-return.wav -map 0:v -map 1:a -c:v copy -c:a pcm_s16le -t 7.2 out/error-return-alpha-sfx.mov",
    "build:error-text-alpha-webm": "remotion render ErrorReturnAlpha out/error-return-alpha.webm --codec=vp9 --image-format=png --pixel-format=yuva420p --crf=12",
    "build:error-text-sfx": "python3 tools/make_sfx.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/layout-utils": "4.0.529",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
