---
import { site, telLink, zaloLink } from '../data/site';
import SocialLinks from './SocialLinks.astro';

const { phone, email, location } = site.contact;
const phoneDisplay = phone.replace(/\D/g, '').replace(/(\d{4})(\d{3})(\d+)/, '$1 $2 $3');
---

<section id="lien-he" class="scroll-mt-20 border-t border-line">
  <div class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-8 sm:py-32">
    <p class="mb-4 text-xs tracking-[0.35em] text-accent uppercase">Liên hệ</p>
    <h2 class="mx-auto max-w-3xl text-3xl font-bold sm:text-5xl">
      Bạn có dự án cần quay? Nói chuyện với mình nhé.
    </h2>

    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={zaloLink}
        target="_blank"
        rel="noopener"
        class="w-full rounded-full bg-accent px-8 py-3 font-medium text-ink transition hover:bg-paper sm:w-auto"
      >
        Nhắn Zalo
      </a>
      <a
        href={telLink}
        class="w-full rounded-full border border-paper/30 px-8 py-3 transition hover:border-accent hover:text-accent sm:w-auto"
      >
        Gọi {phoneDisplay}
      </a>
    </div>

    {
      email && (
        <p class="mt-6">
          <a href={`mailto:${email}`} class="text-paper/80 underline-offset-4 hover:underline">
            {email}
          </a>
        </p>
      )
    }
    {location && <p class="mt-3 text-sm text-muted">{location}</p>}

    <div class="mt-10 flex justify-center">
      <SocialLinks size="size-6" />
    </div>
  </div>
</section>
