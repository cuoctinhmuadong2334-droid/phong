---
import { site } from '../data/site';
---

<section id="dich-vu" class="scroll-mt-20 border-y border-line bg-panel">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-8 sm:py-28">
    <h2 class="mb-12 text-3xl font-bold sm:text-4xl">Dịch vụ</h2>
    <ol class="grid gap-px overflow-hidden rounded bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        site.services.map((s, i) => (
          <li class="bg-panel p-6 sm:p-8">
            <span class="text-sm text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-xl font-medium">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
